#!/usr/bin/env bash
set -Eeuo pipefail

OMA_BIN=${OMA_BIN:-/usr/bin/oma}
OMACTL_VERSION=${OMACTL_VERSION:-0.1.0}
OMACTL_STATE_DIR=${OMACTL_STATE_DIR:-${XDG_RUNTIME_DIR:-/run}/omactl}

usage(){ cat <<'EOF'
Usages:
  omactl capabilities --json
  omactl query installed|upgradable|package-detail|search --json [args...]
  omactl run <upgrade|install|remove|refresh> --json [--unit <name>] [--yes] [args...]
  omactl run [--wait] [--follow] [--unit=<name>] -- <oma-args...>
  omactl status [--json] <unit>
  omactl logs|log [--json] [--follow] <unit>
  omactl cancel|stop [--json] <unit>
  omactl result|rc [--json] <unit>
  omactl list
EOF
}

die(){ echo "[omactl] error: $*" >&2; exit 1; }

json_escape(){
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//"/\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

json_ok(){
  local kind=$1 data=${2:-}
  [[ -n "$data" ]] || data='{}'
  printf '{"schema_version":1,"ok":true,"kind":%s,"data":%s}\n' "$(json_escape "$kind")" "$data"
}

json_error(){
  local code=$1 message=$2 details=${3:-}
  [[ -n "$details" ]] || details='{}'
  printf '{"schema_version":1,"ok":false,"kind":"omactl.error","error":{"code":%s,"message":%s,"details":%s}}\n' \
    "$(json_escape "$code")" "$(json_escape "$message")" "$details"
}

fail_json(){
  local code=$1 message=$2 details=${3:-}
  [[ -n "$details" ]] || details='{}'
  json_error "$code" "$message" "$details"
  exit 1
}

is_json_flag(){ [[ "${1:-}" == "--json" ]]; }

has_json_arg(){
  local arg
  for arg in "$@"; do
    [[ "$arg" == "--json" ]] && return 0
  done
  return 1
}

require_python(){
  command -v python3 >/dev/null 2>&1 || fail_json INTERNAL_ERROR "python3 is required for JSON output"
}

valid_unit_syntax(){
  local unit=$1
  [[ ${#unit} -ge 1 && ${#unit} -le 80 && "$unit" =~ ^[A-Za-z0-9_.@-]+$ ]]
}

valid_omactl_unit_name(){
  local unit=$1
  [[ "$unit" == oma-task-* ]] && valid_unit_syntax "$unit"
}

require_unit(){
  local unit=${1:-}
  [[ -n "$unit" ]] || fail_json INVALID_ARGUMENTS "missing unit" '{"argument":"unit"}'
  valid_unit_syntax "$unit" || fail_json INVALID_ARGUMENTS "invalid unit name" '{"argument":"unit"}'
}

require_omactl_unit(){
  local unit=${1:-}
  [[ -n "$unit" ]] || fail_json INVALID_ARGUMENTS "missing unit" '{"argument":"unit"}'
  valid_omactl_unit_name "$unit" || fail_json INVALID_ARGUMENTS "invalid unit name" '{"argument":"unit"}'
}

unit_dir(){
  printf '%s/units' "$OMACTL_STATE_DIR"
}

unit_record(){
  printf '%s/%s' "$(unit_dir)" "$1"
}

ensure_state_dir(){
  [[ ! -L "$OMACTL_STATE_DIR" ]] || fail_json INTERNAL_ERROR "unsafe omactl state directory"
  mkdir -p "$OMACTL_STATE_DIR" "$(unit_dir)" || fail_json INTERNAL_ERROR "failed to create omactl state directory"
  [[ ! -L "$(unit_dir)" ]] || fail_json INTERNAL_ERROR "unsafe omactl unit state directory"
  chmod 700 "$OMACTL_STATE_DIR" "$(unit_dir)" 2>/dev/null || true
}

show_field(){
  local show=$1 key=$2
  awk -F= -v k="$key" '$1 == k { print substr($0, index($0, "=") + 1); exit }' <<<"$show"
}

current_unit_show(){
  local unit=$1
  systemctl show "$unit" -p ActiveState -p SubState -p Result -p ExecMainStatus -p Id -p InvocationID -p LoadState
}

record_field(){
  local record=$1 key=$2
  awk -F= -v k="$key" '$1 == k { print substr($0, index($0, "=") + 1); exit }' "$record" 2>/dev/null
}

record_unit(){
  local unit=$1 operation=$2 record show id invocation load_state
  ensure_state_dir
  record="$(unit_record "$unit")"
  [[ ! -L "$record" ]] || fail_json INTERNAL_ERROR "unsafe omactl unit record"
  if ! show=$(current_unit_show "$unit" 2>/dev/null); then
    fail_json SYSTEMD_FAILED "failed to verify scheduled systemd unit" "{\"unit\":$(json_escape "$unit")}"
  fi
  id=$(show_field "$show" Id)
  invocation=$(show_field "$show" InvocationID)
  load_state=$(show_field "$show" LoadState)
  [[ "$id" == "$unit" && -n "$invocation" && "$load_state" != "not-found" ]] || \
    fail_json SYSTEMD_FAILED "failed to verify scheduled systemd unit identity" "{\"unit\":$(json_escape "$unit")}"
  (
    umask 077
    {
      printf 'unit=%s\n' "$unit"
      printf 'operation=%s\n' "$operation"
      printf 'invocation_id=%s\n' "$invocation"
    } >"$record"
  ) || fail_json INTERNAL_ERROR "failed to retain omactl unit"
}

owned_unit(){
  local unit=$1 record show id invocation load_state stored_invocation stored_unit
  valid_omactl_unit_name "$unit" || return 1
  record="$(unit_record "$unit")"
  [[ -f "$record" && ! -L "$record" ]] || return 1
  stored_unit=$(record_field "$record" unit)
  stored_invocation=$(record_field "$record" invocation_id)
  [[ "$stored_unit" == "$unit" && -n "$stored_invocation" ]] || return 1
  show=$(current_unit_show "$unit" 2>/dev/null) || return 1
  id=$(show_field "$show" Id)
  invocation=$(show_field "$show" InvocationID)
  load_state=$(show_field "$show" LoadState)
  [[ "$id" == "$unit" && -n "$invocation" && "$invocation" == "$stored_invocation" && "$load_state" != "not-found" ]]
}

systemd_unit_exists(){
  local unit=$1
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl list-units --all --full --plain --no-legend "$unit" 2>/dev/null | grep -Fq "$unit"
}

require_owned_unit(){
  local unit=${1:-}
  require_unit "$unit"
  valid_omactl_unit_name "$unit" || fail_json UNKNOWN_UNIT "unit was not started by omactl" "{\"unit\":$(json_escape "$unit")}"
  owned_unit "$unit" || fail_json UNKNOWN_UNIT "unit was not started by omactl" "{\"unit\":$(json_escape "$unit")}"
}

reject_unit_collision(){
  local unit=$1 record
  record="$(unit_record "$unit")"
  if [[ -L "$record" ]]; then
    fail_json INTERNAL_ERROR "unsafe omactl unit record" "{\"unit\":$(json_escape "$unit")}"
  fi
  if [[ -e "$record" ]] && owned_unit "$unit"; then
    fail_json INVALID_ARGUMENTS "unit name collides with an omactl-retained unit" "{\"unit\":$(json_escape "$unit")}"
  fi
  if [[ -e "$record" && ! -L "$record" ]] && ! owned_unit "$unit"; then
    rm -f "$record" 2>/dev/null || true
  fi
  if systemd_unit_exists "$unit"; then
    fail_json INVALID_ARGUMENTS "unit name collides with an existing systemd unit" "{\"unit\":$(json_escape "$unit")}"
  fi
}

generate_unit(){
  if [[ -n "${OMACTL_UNIT_SEED:-}" ]]; then
    printf 'oma-task-%s.service' "$OMACTL_UNIT_SEED"
  else
    printf 'oma-task-%s-%s.service' "$(date +%Y%m%d%H%M%S)" "$RANDOM"
  fi
}

oma_busy(){
  [[ "${OMACTL_DISABLE_BUSY_CHECK:-}" == "1" ]] && return 1
  [[ -e /run/lock/oma.lock ]]
}

python_or_malformed(){
  python3 "$@" || return 1
}

wrap_json_items(){
  local kind=$1 key=$2 required_csv=${3:-}
  require_python
  local data
  if ! data=$(python_or_malformed -c '
import json, sys
kind, key, required_csv = sys.argv[1], sys.argv[2], sys.argv[3]
required = [x for x in required_csv.split(",") if x]
def status_tokens(value):
    if value in (None, ""):
        return []
    if isinstance(value, str):
        raw = value.replace(",", " ").split()
    elif isinstance(value, list):
        raw = value
    else:
        raw = [value]
    tokens = []
    for token in raw:
        token = str(token).strip().lower()
        if token and all(32 <= ord(ch) <= 126 for ch in token):
            tokens.append(token)
    return tokens
items = []
text = sys.stdin.read()
if text.strip():
    try:
        parsed = json.loads(text)
        values = [parsed]
    except json.JSONDecodeError:
        values = []
        for raw in text.splitlines():
            raw = raw.strip()
            if not raw:
                continue
            values.append(json.loads(raw))
else:
    values = []
for value in values:
    if isinstance(value, list):
        items.extend(value)
    else:
        items.append(value)
for item in items:
    if required and not isinstance(item, dict):
        raise ValueError("non-object item in delegated JSON")
    if isinstance(item, dict):
        status_values = set(status_tokens(item.get("status")))
        if kind == "omactl.query.installed":
            status_values.add("installed")
        if kind == "omactl.query.upgradable" or item.get("new_version") not in (None, ""):
            status_values.add("upgradable")
        if item.get("installed") is True:
            status_values.add("installed")
        if item.get("held") is True:
            status_values.add("held")
        if item.get("automatic") is True:
            status_values.add("automatic")
        item["status"] = ",".join(sorted(status_values))
        if item.get("new_version") in (None, ""):
            item.pop("new_version", None)
        elif not isinstance(item.get("new_version"), str):
            raise ValueError("invalid new_version for {}".format(item.get("name", "<unknown>")))
        if kind == "omactl.query.installed":
            item["installed"] = True
        else:
            item["installed"] = "installed" in status_values
        if kind == "omactl.query.upgradable":
            item["upgradable"] = True
        else:
            item["upgradable"] = "upgradable" in status_values
        item["held"] = "held" in status_values
        item["automatic"] = "automatic" in status_values
        missing = [field for field in required if field not in item or item.get(field) is None]
        if missing:
            raise ValueError("missing required fields for {}: {}".format(item.get("name", "<unknown>"), ",".join(missing)))
        for field in required:
            if field == "branches":
                if not isinstance(item[field], list) or not all(isinstance(branch, str) for branch in item[field]):
                    raise ValueError("invalid branches for {}".format(item.get("name", "<unknown>")))
            elif not isinstance(item[field], str):
                raise ValueError("invalid {} for {}".format(field, item.get("name", "<unknown>")))
print(json.dumps({"packages": items} if key == "packages" else {"results": items}, separators=(",", ":")))
' "$kind" "$key" "$required_csv"); then
    return 1
  fi
  json_ok "$kind" "$data"
}

lines_to_logs_json(){
  local unit=$1
  require_python
  python_or_malformed -c '
import json, sys
unit = sys.argv[1]
lines = [line.rstrip("\n") for line in sys.stdin]
print(json.dumps({"unit": unit, "lines": lines}, separators=(",", ":")))
' "$unit"
}

systemd_show_json(){
  local unit=$1
  require_python
  python_or_malformed -c '
import json, sys
unit = sys.argv[1]
fields = {}
for raw in sys.stdin:
    raw = raw.rstrip("\n")
    if "=" in raw:
        key, value = raw.split("=", 1)
        fields[key] = value
active = fields.get("ActiveState", "unknown")
sub = fields.get("SubState", "")
result = fields.get("Result", "")
if result in {"canceled", "cancelled"} or sub in {"stop-sigterm", "stop-sigint"}:
    state = "cancelled"
elif active == "active":
    state = "running"
elif active == "activating":
    state = "pending"
elif result == "success":
    state = "succeeded"
elif active == "failed" or result not in {"", "success"}:
    state = "failed"
else:
    state = "unknown"
print(json.dumps({"unit": unit, "state": state, "systemd": fields}, separators=(",", ":")))
' "$unit"
}

capabilities_json(){
  local oma_path="" oma_version=""
  local caps=()
  if command -v "$OMA_BIN" >/dev/null 2>&1 || [[ -x "$OMA_BIN" ]]; then
    oma_path=$(command -v "$OMA_BIN" 2>/dev/null || printf '%s' "$OMA_BIN")
    oma_version=$("$OMA_BIN" --version 2>/dev/null | head -n1 || true)
    if command -v python3 >/dev/null 2>&1; then
      caps+=("query.installed.v1" "query.upgradable.v1" "query.package-detail.v1")
    fi
    if command -v systemd-run >/dev/null 2>&1; then
      caps+=("run.upgrade.v1" "run.install.v1" "run.remove.v1" "run.refresh.v1")
      if command -v python3 >/dev/null 2>&1; then
        caps+=("run.upgrade.selected.v1")
      fi
    fi
  fi
  if command -v python3 >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
    caps+=("unit.status.v1" "unit.result.v1" "unit.cancel.v1")
  fi
  if command -v python3 >/dev/null 2>&1 && command -v journalctl >/dev/null 2>&1; then
    caps+=("unit.logs.v1")
  fi
  local caps_json
  if [[ ${#caps[@]} -eq 0 ]]; then
    caps_json='[]'
  else
    caps_json=$(printf '%s\n' "${caps[@]}" | python3 -c 'import json,sys; print(json.dumps([x.strip() for x in sys.stdin if x.strip()]))' 2>/dev/null || printf '[]')
  fi
  local data
  data=$(printf '{"omactl_version":%s,"oma_path":%s,"oma_version":%s,"capabilities":%s}' \
    "$(json_escape "$OMACTL_VERSION")" "$(json_escape "$oma_path")" "$(json_escape "$oma_version")" "$caps_json")
  json_ok omactl.capabilities "$data"
}

query_json(){
  local topic=${1:-}; shift || true
  case "$topic" in
    installed)
      [[ "${1:-}" == "--json" ]] || die "query installed requires --json"
      local out
      if ! out=$("$OMA_BIN" list --installed --json); then
        fail_json OMA_EXEC_FAILED "delegated oma command failed"
      fi
      if ! printf '%s\n' "$out" | wrap_json_items omactl.query.installed packages name,architecture,current_version,branches; then
        fail_json MALFORMED_DELEGATE_OUTPUT "failed to parse delegated oma JSON"
      fi
      ;;
    upgradable)
      [[ "${1:-}" == "--json" ]] || die "query upgradable requires --json"
      local out
      if ! out=$("$OMA_BIN" list --upgradable --json); then
        fail_json OMA_EXEC_FAILED "delegated oma command failed"
      fi
      if ! printf '%s\n' "$out" | wrap_json_items omactl.query.upgradable packages name,architecture,current_version,new_version; then
        fail_json MALFORMED_DELEGATE_OUTPUT "failed to parse delegated oma JSON"
      fi
      ;;
    package-detail)
      [[ "${1:-}" == "--json" ]] || die "query package-detail requires --json"
      shift
      [[ $# -gt 0 ]] || fail_json INVALID_ARGUMENTS "package-detail requires at least one package" '{"argument":"package"}'
      local out
      if ! out=$("$OMA_BIN" show --json "$@"); then
        fail_json OMA_EXEC_FAILED "delegated oma command failed"
      fi
      if ! printf '%s\n' "$out" | wrap_json_items omactl.query.package-detail packages name; then
        fail_json MALFORMED_DELEGATE_OUTPUT "failed to parse delegated oma JSON"
      fi
      ;;
    search)
      [[ "${1:-}" == "--json" ]] || die "query search requires --json"
      shift
      [[ $# -gt 0 ]] || fail_json INVALID_ARGUMENTS "search requires at least one term" '{"argument":"term"}'
      local out
      if ! out=$("$OMA_BIN" search --json "$@"); then
        fail_json OMA_EXEC_FAILED "delegated oma command failed"
      fi
      if ! printf '%s\n' "$out" | wrap_json_items omactl.query.search results name; then
        fail_json MALFORMED_DELEGATE_OUTPUT "failed to parse delegated oma JSON"
      fi
      ;;
    *) fail_json UNSUPPORTED_COMMAND "unsupported query topic" "{\"topic\":$(json_escape "$topic")}";;
  esac
}

legacy_run(){
  local unit="$(generate_unit)" wait=0 follow=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait=1;;
      --follow) follow=1;;
      --unit=*) unit="${1#--unit=}";;
      --) shift; break;;
      *) break;;
    esac; shift || true
  done
  args=("$@")
  run_args=(
    --unit="$unit"
    -p Type=exec
    -p KillMode=control-group
    -p KillSignal=SIGINT
    -p TimeoutStopSec=120
    -p Restart=no
    -p StandardOutput=journal
    -p StandardError=journal
    -p WorkingDirectory=/
    -p PrivateTmp=yes
  )
  (( wait )) && run_args+=(--wait --pipe)
  systemd-run "${run_args[@]}" "$OMA_BIN" "${args[@]}"
  echo "unit=$unit"
  (( follow )) && journalctl -fu "$unit" || true
}

run_json(){
  local operation=${1:-}; shift || true
  local json=0 unit="" yes=0 remove_config=0 purpose="" passthrough=0
  local selection_json=""
  local packages=()
  while [[ $# -gt 0 ]]; do
    if (( passthrough )); then packages+=("$1"); shift; continue; fi
    case "$1" in
      --json) json=1;;
      --unit)
        [[ $# -ge 2 && "${2:-}" != --* ]] || fail_json INVALID_ARGUMENTS "missing --unit value" '{"argument":"unit"}'
        shift; unit=$1;;
      --unit=*) unit=${1#--unit=};;
      --yes|-y) yes=1;;
      --remove-config|--remove_config) remove_config=1;;
      --purpose)
        [[ $# -ge 2 && "${2:-}" != --* ]] || fail_json INVALID_ARGUMENTS "missing --purpose value" '{"argument":"purpose"}'
        shift; purpose=$1;;
      --) passthrough=1;;
      *) packages+=("$1");;
    esac
    shift || true
  done
  (( json )) || die "run <operation> requires --json"
  [[ -n "$unit" ]] || unit="$(generate_unit)"
  require_omactl_unit "$unit"
  local oma_args=()
  case "$operation" in
    install)
      [[ ${#packages[@]} -gt 0 ]] || fail_json INVALID_ARGUMENTS "install requires at least one package" '{"argument":"package"}'
      oma_args=(install)
      (( yes )) && oma_args+=(--yes)
      oma_args+=("${packages[@]}")
      ;;
    remove)
      [[ ${#packages[@]} -gt 0 ]] || fail_json INVALID_ARGUMENTS "remove requires at least one package" '{"argument":"package"}'
      oma_args=(remove)
      (( yes )) && oma_args+=(--yes)
      (( remove_config )) && oma_args+=(--remove-config)
      oma_args+=("${packages[@]}")
      ;;
    upgrade)
      oma_args=(upgrade)
      (( yes )) && oma_args+=(--yes)
      [[ ${#packages[@]} -eq 0 ]] || oma_args+=("${packages[@]}")
      if [[ ${#packages[@]} -gt 0 ]]; then
        require_python
        local requested
        if ! requested=$(printf '%s\n' "${packages[@]}" | python3 -c 'import json,sys; print(json.dumps([x.rstrip("\n") for x in sys.stdin]))'); then
          fail_json INTERNAL_ERROR "failed to encode selected packages"
        fi
        selection_json="\"selection\":{\"requested\":$requested,\"not_upgradable\":[],\"not_found\":[]}"
      fi
      ;;
    refresh)
      [[ "$purpose" == "refresh" || "$purpose" == "check-updates" ]] || fail_json INVALID_ARGUMENTS "refresh requires --purpose refresh|check-updates" '{"argument":"purpose"}'
      oma_args=(refresh)
      ;;
    *) fail_json UNSUPPORTED_COMMAND "unsupported run operation" "{\"operation\":$(json_escape "$operation")}";;
  esac
  ensure_state_dir
  reject_unit_collision "$unit"
  oma_busy && fail_json OMA_BUSY "oma is busy"
  local run_args=(
    --unit="$unit"
    -p Type=exec
    -p KillMode=control-group
    -p KillSignal=SIGINT
    -p TimeoutStopSec=120
    -p Restart=no
    -p StandardOutput=journal
    -p StandardError=journal
    -p WorkingDirectory=/
    -p PrivateTmp=yes
  )
  if ! systemd-run "${run_args[@]}" "$OMA_BIN" "${oma_args[@]}" >/dev/null; then
    fail_json SYSTEMD_FAILED "failed to schedule systemd unit" "{\"unit\":$(json_escape "$unit")}"
  fi
  record_unit "$unit" "$operation"
  local data
  data=$(printf '{"unit":%s,"operation":%s' "$(json_escape "$unit")" "$(json_escape "$operation")")
  if [[ "$operation" == "refresh" ]]; then
    data+=",\"purpose\":$(json_escape "$purpose")"
  fi
  if [[ -n "$selection_json" ]]; then
    data+=",$selection_json"
  fi
  data+='}'
  json_ok omactl.operation.started "$data"
}

status_json(){
  local unit=${1:-}
  require_owned_unit "$unit"
  local data
  if ! data=$(current_unit_show "$unit" | systemd_show_json "$unit"); then
    fail_json SYSTEMD_FAILED "failed to inspect systemd unit" "{\"unit\":$(json_escape "$unit")}"
  fi
  json_ok omactl.unit.status "$data"
}

result_json(){
  local unit=${1:-}
  require_owned_unit "$unit"
  local data
  if ! data=$(current_unit_show "$unit" | systemd_show_json "$unit"); then
    fail_json SYSTEMD_FAILED "failed to inspect systemd unit" "{\"unit\":$(json_escape "$unit")}"
  fi
  json_ok omactl.unit.result "$data"
}

logs_json(){
  local follow=0
  if [[ "${1:-}" == "--follow" ]]; then follow=1; shift; fi
  local unit=${1:-}
  require_owned_unit "$unit"
  if (( follow )); then
    require_python
    python3 - "$unit" <<'PY'
import json
import select
import subprocess
import sys
import time

unit = sys.argv[1]

def envelope(kind, ok=True, data=None, error=None):
    payload = {"schema_version": 1, "ok": ok, "kind": kind}
    if ok:
        payload["data"] = data or {}
    else:
        payload["error"] = error or {}
    print(json.dumps(payload, separators=(",", ":")), flush=True)

def state():
    try:
        proc = subprocess.run(
            [
                "systemctl",
                "show",
                unit,
                "-p",
                "ActiveState",
                "-p",
                "SubState",
                "-p",
                "Result",
                "-p",
                "LoadState",
            ],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return "unknown"
    fields = {}
    for raw in proc.stdout.splitlines():
        if "=" in raw:
            key, value = raw.split("=", 1)
            fields[key] = value
    active = fields.get("ActiveState", "unknown")
    sub = fields.get("SubState", "")
    result = fields.get("Result", "")
    if result in {"canceled", "cancelled"} or sub in {"stop-sigterm", "stop-sigint"}:
        return "cancelled"
    if active == "active":
        return "running"
    if active == "activating":
        return "pending"
    if result == "success":
        return "succeeded"
    if active == "failed" or result not in {"", "success"}:
        return "failed"
    return "unknown"

try:
    proc = subprocess.Popen(
        ["journalctl", "-u", unit, "-f", "-o", "cat", "--no-pager"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
except OSError as exc:
    envelope(
        "omactl.error",
        ok=False,
        error={
            "code": "SYSTEMD_FAILED",
            "message": "failed to follow unit logs",
            "details": {"unit": unit, "reason": str(exc)},
        },
    )
    sys.exit(1)

try:
    while True:
        if proc.stdout is not None:
            readable, _, _ = select.select([proc.stdout], [], [], 0.5)
            if readable:
                line = proc.stdout.readline()
                if line:
                    envelope("omactl.unit.log-line", data={"unit": unit, "line": line.rstrip("\n")})
                    continue
                break
        if proc.poll() is not None:
            break
        if state() in {"succeeded", "failed", "cancelled"}:
            # Give journald a brief grace period to deliver trailing log lines.
            deadline = time.monotonic() + 0.5
            while proc.stdout is not None and time.monotonic() < deadline:
                readable, _, _ = select.select([proc.stdout], [], [], 0.1)
                if not readable:
                    continue
                line = proc.stdout.readline()
                if line:
                    envelope("omactl.unit.log-line", data={"unit": unit, "line": line.rstrip("\n")})
                else:
                    break
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
            sys.exit(0)
    rc = proc.wait()
    if rc == 0:
        sys.exit(0)
    envelope(
        "omactl.unit.log-error",
        ok=False,
        error={
            "code": "SYSTEMD_FAILED",
            "message": "failed while following unit logs",
            "details": {"unit": unit, "exit_status": rc},
        },
    )
    sys.exit(1)
finally:
    if proc.poll() is None:
        proc.terminate()
PY
  else
    local data
    if ! data=$(journalctl -u "$unit" -o cat --no-pager | lines_to_logs_json "$unit"); then
      fail_json SYSTEMD_FAILED "failed to read unit logs" "{\"unit\":$(json_escape "$unit")}"
    fi
    json_ok omactl.unit.logs "$data"
  fi
}

cancel_json(){
  local unit=${1:-}
  require_owned_unit "$unit"
  local current
  current=$(systemctl show "$unit" -p ActiveState -p SubState -p Result -p ExecMainStatus -p Id | systemd_show_json "$unit" || true)
  if [[ "$current" == *'"state":"succeeded"'* || "$current" == *'"state":"failed"'* || "$current" == *'"state":"cancelled"'* ]]; then
    json_ok omactl.unit.cancel "{\"unit\":$(json_escape "$unit"),\"state\":\"already_terminal\",\"result\":$current}"
    return 0
  fi
  if ! systemctl stop "$unit" >/dev/null; then
    fail_json SYSTEMD_FAILED "failed to cancel systemd unit" "{\"unit\":$(json_escape "$unit")}"
  fi
  json_ok omactl.unit.cancel "{\"unit\":$(json_escape "$unit"),\"state\":\"cancelled\"}"
}

plan_json(){
  fail_json UNSUPPORTED_COMMAND "planning is not supported by this omactl build"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  capabilities)
    [[ "${1:-}" == "--json" ]] || { usage; exit 1; }
    capabilities_json
    ;;
  query)
    query_json "$@"
    ;;
  plan)
    plan_json "$@"
    ;;
  run)
    if has_json_arg "$@"; then
      run_json "$@"
    else
      legacy_run "$@"
    fi
    ;;
  status)
    if [[ "${1:-}" == "--json" ]]; then shift; status_json "${1:-}"; else systemctl status "${1:?unit?}" --no-pager; fi
    ;;
  logs|log)
    if [[ "${1:-}" == "--json" ]]; then shift; logs_json "$@"; else journalctl -u "${1:?unit?}" -e; fi
    ;;
  cancel|stop)
    if [[ "${1:-}" == "--json" ]]; then shift; cancel_json "${1:-}"; else systemctl stop "${1:?unit?}"; fi
    ;;
  result|rc)
    if [[ "${1:-}" == "--json" ]]; then shift; result_json "${1:-}"; else systemctl show "${1:?unit?}" -p Result -p ExecMainStatus -p ActiveState -p SubState; fi
    ;;
  list)
    systemctl list-units 'oma-task-*'
    ;;
  *) usage; exit 1;;
esac
